# PostgreSQL connection string (Neon, Prisma Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Base URL of the deployed app (used for email links). For local dev:
AUTH_URL="http://localhost:3000"

# Resend (https://resend.com) - used to send booking/approval emails.
# Leave blank during local dev to just log emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Leave Booking <leave@yourcompany.com>"

# Used only by the seed script to create the first admin account.
ADMIN_NAME="Kyle Best"
ADMIN_EMAIL="kyle@bestpropertyservices.com"
ADMIN_PASSWORD="change-me-after-first-login"
